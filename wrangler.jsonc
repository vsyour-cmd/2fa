{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "2fa",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "ACCESS_AUD": "ec0202c941bf8f8a55c97d07071a01df8de0f57ad288a178e4daab58b4338274"
  },
  "access": {
    "dev": {
      "aud": "ec0202c941bf8f8a55c97d07071a01df8de0f57ad288a178e4daab58b4338274",
      "identity": {
        "email": "developer@example.invalid",
        "user_uuid": "local-cloudflare-access-user"
      }
    }
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "DATA_KV"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
