{
  "name": "2fa-authenticator",
  "version": "2.0.0",
  "description": "2FA Authenticator with end-to-end encryption",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "2fa",
    "totp",
    "authenticator"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.13",
    "express": "^4.21.2",
    "jose": "^6.2.9",
    "jsqr": "^1.4.0",
    "marked": "^18.0.10",
    "scrypt-js": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
